{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-native-coachmark-onboarding": ["../src/index"],
      "react-native-coachmark-onboarding/*": ["../src/*"],
      "react": ["../node_modules/react"],
      "react/*": ["../node_modules/react/*"],
      "react-native": ["../node_modules/react-native"],
      "react-native/*": ["../node_modules/react-native/*"],
      "@types/react": ["../node_modules/@types/react"],
      "@types/react/*": ["../node_modules/@types/react/*"],
      "@types/react-native": ["../node_modules/@types/react-native"],
      "@types/react-native/*": ["../node_modules/@types/react-native/*"]
    }
  }
}
